# Staging Dockerfile - build với env staging, serve bằng Nginx
FROM node:20-alpine AS build

WORKDIR /app

# Build args cho staging (Vite dùng import.meta.env tại build time)
ARG VITE_API_BASE_URL
ARG VITE_APP_NAME
ARG VITE_DEFAULT_LANGUAGE
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_APP_NAME=${VITE_APP_NAME}
ENV VITE_DEFAULT_LANGUAGE=${VITE_DEFAULT_LANGUAGE}

# Copy package files
COPY package*.json ./

# Install all dependencies (cần devDependencies để build)
RUN npm ci --legacy-peer-deps

# Copy source
COPY . .

# Build app (output vào dist)
RUN npm run build

# Stage 2: serve bằng Nginx
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
